#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
export DOTNET_CLI_TELEMETRY_OPTOUT=1
scripts/bootstrap
for project in Tests PenTests DynamicScrollTests PresetTests DebuggerTests RememberMouseTests; do
  dotnet run --project "$project" -c Release
done
bash -n scripts/bootstrap scripts/build scripts/test scripts/install
python3 scripts/test_preset_setup.py
python3 scripts/test_toggle_setup.py
python3 - <<'PY'
import json
from pathlib import Path
for path in Path('examples').glob('*.json'):
    json.loads(path.read_text())
print('PASS: example JSON and shell syntax')
PY
