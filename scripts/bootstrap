#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
version=0.6.8
checksum=b2ecfdb5dd1bcdc980d478e2fc629cb8d746c77d137e5b032afc0ab7bbe1b62f
archive="$root/.cache/OpenTabletDriver-$version.tar.gz"
mkdir -p .cache
if [[ ! -f "$archive" ]]; then
  curl --fail --location --retry 3 "https://github.com/OpenTabletDriver/OpenTabletDriver/archive/refs/tags/v$version.tar.gz" -o "$archive.tmp"
  mv "$archive.tmp" "$archive"
fi
printf '%s  %s\n' "$checksum" "$archive" | sha256sum --check --status
if [[ ! -d "OpenTabletDriver-$version" ]]; then
  tar -xzf "$archive" -C "$root"
fi
# The ignored upstream tree is generated build input. Maintain changes in the overlay.
cp -a upstream-overlay/. "OpenTabletDriver-$version/"
printf 'Prepared OpenTabletDriver %s with local UI changes.\n' "$version"
